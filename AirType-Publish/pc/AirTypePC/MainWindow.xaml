<Window x:Class="AirTypePC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:AirTypePC"
        Title="AirType"
        Height="812" Width="508" MinHeight="640" MinWidth="470"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource BrushBg}"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="5" CornerRadius="8" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- ===== 仪表盘线稿背景（弱透明、非交互；参考采样机线条） ===== -->
        <local:DialDecor Grid.RowSpan="3" IsHitTestVisible="False" />

        <!-- ===== 标题栏 ===== -->
        <Grid Grid.Row="0" Background="{StaticResource BrushBg}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Border Width="20" Height="20" BorderBrush="{StaticResource BrushSignal}" BorderThickness="1.4">
                    <TextBlock Text="AT" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource BrushSignal}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AIRTYPE" Margin="10,0,0,0" FontFamily="{StaticResource FontMono}"
                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushText}"
                           VerticalAlignment="Center" />
                <Ellipse Width="7" Height="7" Fill="{StaticResource BrushSignal}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="TERMINAL" Margin="6,0,0,0" Style="{StaticResource MonoLabel}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button x:Name="BtnMin" Style="{StaticResource GhostButton}" Width="36" Height="32"
                        Content="—" FontSize="12" Click="OnMinimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="BtnClose" Style="{StaticResource GhostButton}" Width="36" Height="32"
                        Content="✕" FontSize="12" Click="OnClose"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

                <!-- ===== 配对码读数 ===== -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel Margin="22,20,22,18">
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="PAIR CODE · 配对码" />
                            <Border Style="{StaticResource TagBadge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource BrushSignal}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText" Text="LINK · WAITING" FontFamily="{StaticResource FontMono}"
                                               FontSize="10" Foreground="{StaticResource BrushSignal}"
                                               Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource ReadoutWell}" Margin="0,16,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CodeT0" Text="_" Style="{StaticResource MonoBig}" Margin="0,0,0,0" />
                                <TextBlock x:Name="CodeT1" Text="_" Style="{StaticResource MonoBig}" Margin="14,0,0,0" />
                                <TextBlock x:Name="CodeT2" Text="_" Style="{StaticResource MonoBig}" Margin="14,0,0,0" />
                                <TextBlock x:Name="CodeT3" Text="_" Style="{StaticResource MonoBig}" Margin="14,0,0,0" />
                                <TextBlock x:Name="ReadoutCaret" Text="▮" FontFamily="{StaticResource FontMono}"
                                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushSignal}"
                                           VerticalAlignment="Bottom" Margin="10,0,0,6" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource MonoLabelInk}" Margin="0,4,0,12"
                                   Text="01 · 手机连同一 WiFi → 点发现的电脑 → 输入本码" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnRegen" Style="{StaticResource OutlineButton}" Content="重新生成"
                                    Click="OnRegenerate" />
                            <Button x:Name="BtnDisconnect" Style="{StaticResource OutlineButton}" Content="断开配对"
                                    Click="OnDisconnect" Margin="10,0,0,0" Visibility="Collapsed">
                                <Button.Foreground>
                                    <SolidColorBrush Color="{StaticResource ColorDanger}" />
                                </Button.Foreground>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 已配对设备 ===== -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0"
                        Background="{StaticResource BrushPanelGlass}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource H2}" Text="已配对设备" />
                            <TextBlock x:Name="DeviceCountText" Style="{StaticResource MonoLabel}"
                                       Foreground="{StaticResource BrushSignal}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="00" />
                        </Grid>
                        <TextBlock x:Name="DeviceEmpty" Style="{StaticResource Body}" Margin="0,8,0,0"
                                   Text="尚未配对 —— 请在手机端输入上方的配对码。" />
                        <ItemsControl x:Name="DeviceList" Margin="0,4,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSignal}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource BrushText}"
                                                       FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" FontFamily="{StaticResource FontMono}" />
                                        </StackPanel>
                                        <Border Height="1" Background="{StaticResource BrushLineSoft}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== 链路信息 ===== -->
                <Border Grid.Row="2" Style="{StaticResource Panel2Card}" Margin="0,8,0,0"
                        Background="{StaticResource BrushPanelGlass2}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="LINK INFO · 连接信息" />
                        <TextBlock x:Name="LinkInfoText" Foreground="{StaticResource BrushText}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="{StaticResource FontMono}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSignal}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource MonoLabel}" Foreground="{StaticResource BrushTextDim}"
                                       Text="LOCAL · 本机直连 · 语音不出手机" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 运行日志 ===== -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,8,0,0"
                        Background="{StaticResource BrushPanelGlass}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="运行日志" />
                        <TextBox Grid.Row="1" x:Name="LogBox" Margin="0,8,0,0" IsReadOnly="True"
                                 VerticalAlignment="Stretch"
                                 Background="{StaticResource BrushInsetGlass}" Foreground="{StaticResource BrushTextDim}"
                                 BorderBrush="{StaticResource BrushLine}" BorderThickness="1"
                                 VerticalScrollBarVisibility="Hidden" FontFamily="{StaticResource FontMono}" FontSize="11"
                                 Padding="12" />
                    </Grid>
                </Border>
        </Grid>

        <!-- ===== 底部栏 ===== -->
        <Grid Grid.Row="2" Margin="22,0,22,0">
            <Border Height="1" VerticalAlignment="Top" Background="{StaticResource BrushLineSoft}" />
            <TextBlock x:Name="VerText" Style="{StaticResource MonoLabel}" Text="v1.0.6" VerticalAlignment="Center" />
            <Button x:Name="BtnSettings" Style="{StaticResource PrimaryButton}" Content="设置" Click="OnSettings"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
