<Window x:Class="AirTypePC.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AirType 设置"
        Width="440" Height="620" MinHeight="420"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="{StaticResource BrushBg}"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" CornerRadius="8" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BrushInset}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushSignal}" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="OptText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushTextDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource BrushBg}">
            <TextBlock Text="SETTINGS · 设置" FontFamily="{StaticResource FontMono}" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource BrushText}" VerticalAlignment="Center" Margin="20,0,0,0" />
            <Button x:Name="BtnClose" Style="{StaticResource GhostButton}" Width="36" Height="32"
                    Content="✕" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0"
                    Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,18,22,18">
                <TextBlock Style="{StaticResource FieldLabel}" Text="电脑显示名" />
                <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" MaxLength="40" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="上屏方式" Margin="0,22,0,8" />
                <RadioButton x:Name="RbClip" GroupName="mode" Foreground="{StaticResource BrushTextDim}" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource OptText}" Text="剪贴板粘贴" />
                </RadioButton>
                <RadioButton x:Name="RbKeys" GroupName="mode" Foreground="{StaticResource BrushTextDim}" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource OptText}" Text="逐字键入" />
                </RadioButton>

                <CheckBox x:Name="ChkTray" Margin="0,22,0,0" Foreground="{StaticResource BrushTextDim}">
                    <TextBlock Style="{StaticResource OptText}" Text="关闭窗口时最小化到托盘" />
                </CheckBox>

                <CheckBox x:Name="ChkExclusive" Margin="0,14,0,0" Foreground="{StaticResource BrushTextDim}">
                    <TextBlock Style="{StaticResource OptText}" Text="专一性匹配（同时只允许一台手机配对）" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="22,0,22,0">
            <Border Height="1" VerticalAlignment="Top" Background="{StaticResource BrushLineSoft}" />
            <TextBlock x:Name="VerText" Style="{StaticResource MonoLabel}" Text="AirTypePC v1.0.6" VerticalAlignment="Center" />
            <Button Style="{StaticResource PrimaryButton}" Content="完成" Width="80" Click="OnDone"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
